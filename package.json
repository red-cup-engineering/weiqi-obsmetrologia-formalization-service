{
  "name": "@lenticule-science/weiqi-obsmetrologia-formalization-service",
  "version": "0.1.0",
  "description": "Lean formalization of weiqi over Obsmetrologia, namespace WeiqiObsmetrologia (Board, Ko, Evidence, Admission): board, ko regimes and the 3^n bound, evidence monotonicity, admission as a Hoare program. Build: cd lib/weiqi-obsmetrologia && lake build.",
  "license": "MIT",
  "scripts": {
    "test": "npm run proof:all",
    "proof:board": "cd lib/weiqi-obsmetrologia && lake build WeiqiObsmetrologia.Board",
    "proof:reach": "cd lib/weiqi-obsmetrologia && lake build WeiqiObsmetrologia.ReachClosure",
    "proof:ko": "cd lib/weiqi-obsmetrologia && lake build WeiqiObsmetrologia.Ko",
    "proof:evidence": "cd lib/weiqi-obsmetrologia && lake build WeiqiObsmetrologia.Evidence",
    "proof:admission": "cd lib/weiqi-obsmetrologia && lake build WeiqiObsmetrologia.Admission",
    "proof:all": "cd lib/weiqi-obsmetrologia && lake build",
    "test:preflight": "node --test test/proof-preflight.test.mjs",
    "proof:preflight": "node scripts/proof-preflight.mjs --check",
    "proof:receipt:reach": "node scripts/proof-preflight.mjs reach",
    "proof:receipt:all": "node scripts/proof-preflight.mjs all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/weiqi-obsmetrologia-formalization-service.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
